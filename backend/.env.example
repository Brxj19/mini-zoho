APP_NAME=Northstar Inventory API
API_V1_PREFIX=/api
ENV=development
DATABASE_URL=mysql+pymysql://inventory_user:inventory_pass@mysql:3306/inventory_saas
JWT_SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_TENANT_STATUS=ACTIVE
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@northstar.local
SMTP_FROM_NAME=Northstar Inventory
EMAIL_ENABLED=true
SMS_PROVIDER=local_outbox
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
